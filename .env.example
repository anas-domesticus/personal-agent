DATABASE_URL=postgres://agent:agent@localhost:5432/agent?sslmode=disable
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
ADMIN_MODEL=deepseek/deepseek-v4.1-flash
SEARCH_MODEL=deepseek/deepseek-v4.1-flash
# File and shell tools act inside this directory. Run agentd in a container
# if agents should be fully isolated from the host.
WORKSPACE=local
WORKSPACE_DIR=workspace
