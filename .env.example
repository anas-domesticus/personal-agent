DATABASE_URL=postgres://agent:agent@localhost:5432/agent?sslmode=disable
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
ADMIN_MODEL=deepseek/deepseek-v4.1-flash
SEARCH_MODEL=deepseek/deepseek-v4.1-flash
# File and shell tools act inside this directory. Run the server in a container
# if agents should be fully isolated from the host. Relative paths here and in
# MCP_CONFIG (default mcp.yaml) are against the current directory: use
# absolute ones for a binary installed with `task install`.
WORKSPACE=local
WORKSPACE_DIR=workspace
# `agent serve` listens here. AGENT_TOKEN is the bearer token clients send;
# it is required unless the address is loopback. `agent attach` reads
# AGENT_URL and AGENT_TOKEN. `agent` (server and TUI together) needs neither.
AGENT_LISTEN=127.0.0.1:7433
AGENT_TOKEN=
AGENT_URL=
# Where `agent` writes its log while the TUI has the terminal. Defaults to the
# user cache directory.
AGENT_LOG=
