DATABASE_URL=postgres://agent:agent@localhost:5432/agent?sslmode=disable
OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
SEARCH_MODEL=deepseek/deepseek-v4.1-flash
# File and shell tools act inside this directory. Run the server in a container
# if workflow agents should be isolated from the host. Relative paths here and
# in MCP_CONFIG (default mcp.yaml) use the current directory, so use absolute
# paths for a binary installed with `task install`.
WORKSPACE=local
WORKSPACE_DIR=workspace
# The MCP server has no authentication and only accepts loopback addresses.
# The endpoint is http://127.0.0.1:7433/mcp.
MCP_LISTEN=127.0.0.1:7433
